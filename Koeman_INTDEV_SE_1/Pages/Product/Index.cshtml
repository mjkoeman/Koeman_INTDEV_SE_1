@page
@model Koeman_INTDEV_SE_1.Pages.Product.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<a asp-page="/Winkelmand/Winkelmand" class="btn btn-outline-primary mb-3">🛒 Ga naar winkelmand</a>

<table class="table">
    <thead>
        <tr>
            <th>Afbeelding</th>
            <th>
                @Html.DisplayNameFor(model => model.Product[0].Naam)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Product[0].Beschrijving)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Product[0].Prijs)
            </th>
            <th>Actie</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Product) {
        <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.AfbeeldingUrl))
                    {
                        <img src="@item.AfbeeldingUrl" alt="@item.Naam" width="100" />
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.Naam)</td>
                <td>@Html.DisplayFor(modelItem => item.Beschrijving)</td>
                <td>@Html.DisplayFor(modelItem => item.Prijs)</td>
                <td>
                    <form method="post" asp-page-handler="AddToCart">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button type="submit" class="btn btn-sm btn-primary">Voeg toe aan winkelmandje</button>
                    </form>
                    <a asp-page="./Edit" asp-route-id="@item.ProductId">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ProductId">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ProductId">Delete</a>
                </td>
        </tr>
}
    </tbody>
</table>
