@page
@model Koeman_INTDEV_SE_1.Pages.Bestelling.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Bestelling[0].Besteldatum)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bestelling[0].Totaalbedrag)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bestelling[0].Klant)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Bestelling) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Besteldatum)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Totaalbedrag)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Klant.Adres)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.BestellingId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.BestellingId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.BestellingId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
